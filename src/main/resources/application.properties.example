# ============================================================
# FILE NÀY CHỨA BÍ MẬT — KHÔNG BAO GIỜ COMMIT LÊN GIT
# (đã thêm vào .gitignore; team copy từ application.properties.example
#  rồi điền giá trị thật của máy mình)
# ============================================================

# --- Database ---
db.url=jdbc:sqlserver://localhost:1433;databaseName=TITANGEAR_DB;encrypt=false;trustServerCertificate=true
db.username=sa
db.password=DIEN_MAT_KHAU_SQL_CUA_BAN

# --- Gmail SMTP (App Password) ---
# LƯU Ý: App Password cũ "snrbpuaamjbdcbyq" ĐÃ LỘ trong lịch sử Git.
# Bắt buộc vào Google Account > Security > App passwords để THU HỒI nó
# và tạo App Password MỚI, điền vào đây.
mail.username=DIEN_EMAIL_GUI_OTP
mail.password=THAY_BANG_APP_PASSWORD_MOI

# --- SePay webhook ---
# Sinh key mới (key cũ đã lộ trong Git). Ví dụ chạy trong PowerShell:
#   -join ((48..57)+(97..122) | Get-Random -Count 32 | % {[char]$_})
# rồi cập nhật cùng giá trị trong cấu hình webhook trên trang SePay.
sepay.api-key=THAY_BANG_KEY_MOI_NGAU_NHIEN

# --- Thư mục lưu ảnh upload (NGOÀI target/ để không mất khi mvn clean) ---
# Dùng / thay \ kể cả trên Windows. Tạo sẵn thư mục trước khi chạy app.
upload.dir=C:/TiTanGEAR-data/uploads/images/

# --- Địa chỉ gốc của site (dùng cho link trong email "báo hàng về") ---
# Không khai cũng chạy được (mặc định http://localhost:8080).
# Khi deploy thật, đổi thành tên miền: vd https://titangear.vn
app.base-url=http://localhost:8080
